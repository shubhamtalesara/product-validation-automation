# ---------------------------------------------------------------------------
# TrendTrack API
# ---------------------------------------------------------------------------
TRENDTRACK_API_KEY=
TRENDTRACK_BASE_URL=https://api.trendtrack.io

# ---------------------------------------------------------------------------
# Google Sheets auth - pick ONE:
#  - GOOGLE_SERVICE_ACCOUNT_JSON: simplest, recommended (see SIMPLE_SETUP.md).
#    Paste the entire contents of a downloaded service-account key file.
#  - GOOGLE_CLIENT_ID/SECRET/REFRESH_TOKEN: OAuth, used by the advanced
#    pipeline (see README "Google authentication").
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Research

# Simple mode (see SIMPLE_SETUP.md) - the sheet tab it writes to, and the
# total number of ads to select across ALL competitors combined (the best
# N by impressions, not a fixed number per competitor).
SIMPLE_SHEET_TAB=Competitor Ads
SIMPLE_TOTAL_AD_COUNT=30

# ---------------------------------------------------------------------------
# Meta Marketing API
# ---------------------------------------------------------------------------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_API_VERSION=v21.0
# Shared campaign/ad set every published test creative attaches to.
META_DEFAULT_CAMPAIGN_ID=
META_DEFAULT_ADSET_ID=
# Optional url_tags query string template appended to ad creative links, e.g.
# utm_source=meta&utm_medium=paid&utm_campaign={{campaign.name}}
META_UTM_TEMPLATE=

# ---------------------------------------------------------------------------
# Database (Prisma). Defaults to a local SQLite file next to prisma/schema.prisma
# if left unset. For production, point at Postgres (see README).
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Creative storage
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# ---------------------------------------------------------------------------
# Safety switch - see README "Dry run mode"
# ---------------------------------------------------------------------------
DRY_RUN=true

# ---------------------------------------------------------------------------
# Scheduled job cadence (standard 5-field cron expressions)
# ---------------------------------------------------------------------------
RESEARCH_CRON=0 6 * * *
APPROVAL_CRON=*/5 * * * *
PUBLISH_CRON=* * * * *
PERFORMANCE_CRON=0 */6 * * *

# ---------------------------------------------------------------------------
# Research / scoring
# ---------------------------------------------------------------------------
TOP_AD_COUNT=25
ADS_PER_COMPETITOR_FETCH=200

LONGEVITY_WEIGHT=0.40
REACH_WEIGHT=0.30
GROWTH_WEIGHT=0.20
DUPLICATION_WEIGHT=0.10

# ---------------------------------------------------------------------------
# Winner / loser validation thresholds
# ---------------------------------------------------------------------------
MIN_SPEND=50
MIN_IMPRESSIONS=1000
TARGET_CPA=30
TARGET_ROAS=1.5
MIN_CTR=0.01

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
DEFAULT_TIMEZONE=America/New_York
LOG_LEVEL=info
